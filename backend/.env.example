# ============================================================
# CanchaMania - Variables de entorno
# Copiar este archivo a .env y completar los valores.
# .env NUNCA se versiona.
# ============================================================

# --- Django ---
# Clave secreta. Generar con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=cambiame-por-una-clave-aleatoria-de-50-caracteres

# true en desarrollo, false en produccion
DJANGO_DEBUG=True

# Origenes permitidos, separados por coma
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# development | production
DJANGO_SETTINGS_MODULE=config.settings.development

# --- PostgreSQL ---
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=canchamania
DATABASE_USER=postgres
DATABASE_PASSWORD=cambiame
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Segundos de reutilizacion de conexiones
DATABASE_CONN_MAX_AGE=60

# --- Locale ---
# Zona horaria por defecto de una sucursal nueva (SPEC §1 / §18)
DEFAULT_TIME_ZONE=America/Argentina/Buenos_Aires

# --- Frontend (produccion) ---
# Carpeta con el build de Vite que Django sirve con WhiteNoise
FRONTEND_DIST_DIR=../frontend/dist
