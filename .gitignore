# ==========================================
# CanchaMania - .gitignore
# Los secretos NUNCA deben versionarse
# ==========================================

# --- Secretos / entorno ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.installed.cfg
pip-wheel-metadata/
pip-log.txt
pip-delete-this-directory.txt

# --- Entornos virtuales ---
.venv/
venv/
env/
ENV/

# --- Pytest / pytest-django ---
.pytest_cache/
.cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
junit.xml
*.lcov
.tox/
.nox/

# --- Django ---
*.log
db.sqlite3
db.sqlite3-journal
backend/staticfiles/
backend/media/
staticfiles/
media/

# --- Node / Vite / Vue ---
node_modules/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# El build del frontend no se versiona: se genera con `npm run build`
frontend/dist/

# --- IDEs / editores ---
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~
.project
.settings/
.pydevproject

# --- SO ---
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Sistema / varios ---
*.bak
*.tmp
*.orig
*.rej
coverage/
npm-debug.log
