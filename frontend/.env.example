# ============================================================
# CanchaMania - Frontend - Variables de entorno
# Copiar a .env solo si se necesita cambiar el destino del proxy.
# .env NUNCA se versiona.
# ============================================================

# Destino del proxy de /api en desarrollo (npm run dev).
# Debe ser el runserver de Django.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# En produccion NO hay proxy: el frontend se sirve compilado desde el mismo
# dominio que la API, y el cliente usa rutas relativas (/api/...).
# VITE_API_BASE_URL=/api
